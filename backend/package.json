{
  "name": "heypico-maps-llm",
  "version": "2.0.0",
  "description": "Local LLM with Google Maps integration - Full JavaScript Stack with React + Vite Frontend & MVC Architecture",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "frontend": "cd frontend && npm run dev",
    "dev:all": "concurrently \"npm run dev\" \"npm run frontend\"",
    "build:frontend": "cd frontend && npm run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "llm",
    "google-maps",
    "openwebui",
    "places-api",
    "react",
    "vite",
    "mvc",
    "javascript",
    "nodejs"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "dotenv": "^16.3.1",
    "axios": "^1.6.2",
    "node-cache": "^5.1.2",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "concurrently": "^8.2.2"
  }
}
